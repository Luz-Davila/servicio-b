# Puerto en el que escucha Service B
PORT=3001

# Secreto HMAC compartido con Service A
# IMPORTANTE: debe ser idéntico al valor en el .env global de docker-compose
# Service A usa este mismo valor para verificar los webhooks
HMAC_SECRET=mi-secreto-compartido

# URL interna de Service A para enviar el WebHook
# En Docker: http://service-a:3000
# Local: http://localhost:3000
SERVICE_A_URL=http://service-a:3000
