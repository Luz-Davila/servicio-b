# Opcional: si el repo de infraestructura tiene su .env en la carpeta de arriba, Service B lo lee
# de ahí y este archivo no hace falta. Úsalo solo para correr Service B por separado.
# Copia este archivo como .env (el .env no se sube al repo).

# Puerto en el que escucha Service B
PORT=3001

# Secreto HMAC compartido con Service A (debe ser idéntico en los dos)
HMAC_SECRET=mi-secreto-compartido

# URL de webhook de la tienda (Service A) que se registra al arrancar
# En Docker: http://service-a:3000/webhooks/payments (la define docker-compose)
# Local: http://localhost:3000/webhooks/payments
DEFAULT_WEBHOOK_URL=http://localhost:3000/webhooks/payments

# Opcionales: espera del proveedor simulado y monto desde el que pasa por DEFERRED
# PROCESSING_DELAY_MS=3000
# DEFERRED_THRESHOLD=50000
